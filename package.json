{
  "name": "stl-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Betrachter fuer STL, STEP und IGES im Browser: Datei hineinziehen, Modell pruefen, Anmerkungen setzen, Dokumentation als PDF erzeugen. Die Datei verlaesst den Rechner nicht.",
  "license": "MIT",
  "homepage": "https://reents3d.github.io/stl-viewer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reents3D/stl-viewer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:artifact": "node scripts/check-artifact.mjs dist",
    "sync:densities": "node scripts/sync-densities.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run check:artifact"
  },
  "dependencies": {
    "jspdf": "^3.0.3",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
